# ---------------------------------------------------------------------------
# AI Video Studio — environment template
# Copy to `.env.local` and fill in what you actually have.
# The app boots and runs end-to-end with NONE of these set (mock mode).
# ---------------------------------------------------------------------------

# --- AI Director (natural language -> structured VideoGenerationSpec) -------
# Optional. Without a key the app falls back to the deterministic heuristic
# director, which is fully functional but less nuanced.
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5
# "llm" | "heuristic" | "auto"  (auto = llm when a key exists, else heuristic)
DIRECTOR_MODE=auto

# --- Video generation provider ---------------------------------------------
# "mock" | "comfyui" | "remote-worker"
VIDEO_PROVIDER=mock
# May an unavailable real provider fall back to the mock placeholder renderer?
# Defaults to true in development, false in production — in production a user
# who asked for AI video should get an error, not a labelled placeholder.
ALLOW_MOCK_FALLBACK=true

# ComfyUI adapter (self-hosted, open source). Requires an NVIDIA GPU box
# running ComfyUI with a video model (e.g. Wan 2.x / LTX-Video / SVD).
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Path to a ComfyUI API-format workflow JSON, relative to repo root.
COMFYUI_WORKFLOW=worker/workflows/i2v_default.api.json

# Remote GPU worker (the Python FastAPI service in ./worker).
# Run it on RunPod / Vast.ai / a LAN NVIDIA machine.
REMOTE_WORKER_URL=http://127.0.0.1:8000
REMOTE_WORKER_TOKEN=
# The Amedspor 3-second proof always uses remote-worker directly and refuses
# mock output. For normal UI jobs with the same strict behaviour, set:
# VIDEO_PROVIDER=remote-worker
# ALLOW_MOCK_FALLBACK=false

# --- Storage ---------------------------------------------------------------
STORAGE_DIR=./storage
OUTPUT_DIR=./outputs

# --- Media tooling ---------------------------------------------------------
# Final composition (concat / crop / overlays / encode). If ffmpeg is missing
# the composer degrades to "plan only" and tells you the exact command it
# would have run. Install with: brew install ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Behaviour -------------------------------------------------------------
LOG_LEVEL=info
# Max shots the planner is ever allowed to produce.
MAX_SHOTS=6
# Hard ceiling on a single generation job (ms). A hung provider is aborted.
JOB_TIMEOUT_MS=2700000
# A running job untouched for this long with no owner is marked interrupted (ms).
JOB_STALE_MS=300000
