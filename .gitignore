# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- AI Video Studio ---
# Runtime data: projects, jobs, uploaded reference images, generated clips.
/storage/**
!/storage/.gitkeep
/outputs/**
!/outputs/.gitkeep
# But DO keep the environment template.
!.env.example

# Python worker
worker/.venv/
worker/__pycache__/
**/__pycache__/
*.pyc
worker/models/

# Worker runtime artefacts (default WORKER_OUTPUT_DIR).
/worker_outputs/

# Generated campaign specs: rebuilt by scripts/build-campaign.ts and stamped
# with a fresh createdAt, so committing them just churns the diff.
/docs/campaigns/*.json
